# ----------------------------------------------------------------------------
# CMake output that can land next to the sources
# (in-source configure, or a project opened without an out-of-source build dir)
# ----------------------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
compile_commands.json
CMakeUserPresets.json
.cmake/
.qt/
.qtc_clangd/
.cache/
.qmlcache/
*.qmlc
*.jsc

# ----------------------------------------------------------------------------
# Qt Creator user files (catch-all; the exact names are listed above)
# ----------------------------------------------------------------------------
*.user
*.user.*

# ----------------------------------------------------------------------------
# Qt for WebAssembly build output
# Qt Creator writes these inside build*/ (already ignored above); these are the
# safety net for a deployment build made directly in the source tree.
# ----------------------------------------------------------------------------
*.wasm
*.wast
*.data
*.symbols
*.wasm.map
*.js.map
qtloader.js
qtlogo.svg
.emscripten_cache/
emscripten_cache/

# ----------------------------------------------------------------------------
# Runtime output (LoggerService writes next to the executable)
# ----------------------------------------------------------------------------
logs/
